{
  "name": "awa-ddd",
  "version": "0.9.0",
  "description": "Evidence-driven security assessment tools for DeepSeek Harness, with a local Python and SQLite engine.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "security-assessment",
    "evidence"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./bridge": "./src/bridge.mjs",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.mjs",
    "src/client.js",
    "awa_ddd/**/*.py",
    "skills",
    "docs/**/*.md",
    "examples",
    "cordis.patch.yml",
    "pyproject.toml",
    "README.md",
    "LICENSE",
    "!awa_ddd/tests_*.py",
    "scripts/invoke-request.mjs",
    "scripts/Invoke-AwaDdd.ps1",
    "!**/*.py[cod]",
    "!**/*.sqlite*",
    "!**/*.db",
    "!**/*.db-*",
    "!**/*.tgz",
    "!**/*.log",
    "!**/*.tmp",
    "!**/*.temp",
    "!**/*.bak",
    "!**/*.backup",
    "!**/*.orig",
    "!**/*.rej",
    "!**/*~",
    "!**/*.swp",
    "!**/*.swo",
    "!**/.env",
    "!**/.env.*",
    "!**/*.env",
    "!**/*.env.*",
    "**/*.env.example",
    "**/*.env.*.example",
    "**/*.env.sample",
    "**/*.env.*.sample",
    "**/*.env.template",
    "**/*.env.*.template",
    "!**/node_modules/**",
    "!**/.validation/**",
    "!**/__pycache__/**",
    "!**/.pytest_cache/**",
    "!**/.mypy_cache/**",
    "!**/.ruff_cache/**",
    "!**/.cache/**",
    "!**/.git/**",
    "!**/htmlcov/**",
    "!**/coverage/**",
    "!**/projects/**",
    "!**/data/**",
    "!**/backup/**",
    "!**/backups/**",
    "!**/tests/**",
    "!**/build/**",
    "!**/dist/**",
    "!**/.venv/**",
    "!**/.tox/**",
    "!**/.nox/**"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:bridge": "node --test tests/bridge.test.mjs tests/plugin.test.mjs",
    "check": "node --check src/index.mjs && node --check src/bridge.mjs && node --check src/actions.mjs && node --check src/host-continuation.mjs && node --check src/stop-policy.mjs && node --check src/tool-guidance.mjs && node --check src/tools.mjs && node --check src/mode.mjs && node --check src/client.js && node --check scripts/invoke-request.mjs && node --check scripts/check-package.mjs && npm test",
    "pack:check": "node scripts/check-package.mjs",
    "test:python": "python -X utf8 -B -m unittest discover -s tests -p \"test_*.py\"",
    "test:all": "npm test && npm run test:python"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "acorn": "8.19.0"
  },
  "//peerDependencies": "SDK 必须由宿主提供，插件绝不能自带：@deepseek-ai/dsh-tools 持有模块级 Symbol（TOOL_RUNTIME_SCHEDULER），出现第二份实例会让宿主自己的 ctx.tools 查不到该 Symbol，进而 crash 整个会话创建。",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.4 <4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "bin": {
    "awa-ddd-request": "scripts/invoke-request.mjs"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
